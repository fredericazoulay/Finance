# Copy variable names into your runtime environment; no credential values belong here.
# DATABASE_URL= (read-only PostgreSQL connection string; unset until authorized)
# MISTRAL_API_KEY= (required only for POST /api/assistant)
# MISTRAL_MODEL=mistral-small-latest
# HOST=127.0.0.1
# PORT=8080
# PRICER_API_URL=http://127.0.0.1:8080
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=pricer@localhost
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# AUDIT_TO=audit@cdc.hackathon
# MAILPIT_API_URL=http://127.0.0.1:8025
