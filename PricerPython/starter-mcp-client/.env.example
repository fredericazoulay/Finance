# ------------------------------------------------------------------
# Configuration des exemples de connexion | copiez-moi en .env
# ------------------------------------------------------------------
# Les deux scripts lisent ces variables. Le fichier .env réel ne doit
# jamais être commité : il contient vos clés (voir .gitignore).

# URL du serveur MCP, avec le chemin « /mcp ».
#
# Scénario A - serveur local (le dépôt mcp-serveur-minimal lancé avec
#   « python serveur.py --transport http »). Pas d'authentification :
#   laissez MCP_API_KEY vide - aucun en-tête Authorization ne sera
#   envoyée.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_API_KEY=

# Scénario B - votre serveur d'équipe pendant le hackathon : l'URL et la
#   clé qui vous seront remises. La clé part dans l'en-tête
#   « Authorization: Bearer <clé> ».
# MCP_SERVER_URL=https://VOTRE-SERVEUR.exemple/mcp
# MCP_API_KEY=VOTRE-CLE

# Uniquement pour l'exemple 2 (agent_langchain.py) : clé Mistral et
# modèle, nécessaires pour que le LLM raisonne.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
